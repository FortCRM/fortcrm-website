---
import Container from "@components/Container.astro";
import BackToTop from "@components/BackToTop.astro";
import { instellingen, posts } from "@lib/content";
import { pad, SITE, type Lang } from "@consts";

const { lang } = Astro.props as { lang: Lang };
const i = await instellingen(lang);
const m = i.menu, f = i.footer, b = i.bedrijf;
const laatste = (await posts(lang)).slice(0, SITE.BLOG_IN_FOOTER);
const home = pad(lang);
const tel = (b.telefoon || "").replace(/[^+0-9]/g, "");
---

<footer>
  <Container>
    <div class="relative">
      <div class="absolute right-0 -top-20">
        <BackToTop label={lang === "nl" ? "Naar boven" : "Back to top"} />
      </div>
    </div>
    <div class="grid gap-8 sm:grid-cols-3 py-10 border-t border-black/10 dark:border-white/10">
      <div class="space-y-3">
        <img src="/logo-inkt.png" alt="FortCRM" width="120" height="41" class="h-8 w-auto dark:hidden" />
        <img src="/logo-linnen.png" alt="FortCRM" width="120" height="41" class="h-8 w-auto hidden dark:block" />
        <p>{f.tagline}</p>
      </div>
      <div class="space-y-2">
        <div class="font-semibold text-black dark:text-white">{f.paginas}</div>
        <ul class="space-y-1">
          <li><a class="navlink" href={`${home}#aanpak`}>{m.aanpak}</a></li>
          <li><a class="navlink" href={`${home}#pakketten`}>{m.pakketten}</a></li>
          {m.quickscan && lang === "nl" && <li><a class="navlink" href="/quick-scan/">{m.quickscan}</a></li>}
          <li><a class="navlink" href={`${home}#faq`}>{m.faq}</a></li>
          <li><a class="navlink" href={pad(lang, "/blog/")}>{m.blog}</a></li>
        </ul>
        {laatste.length > 0 && (
          <>
            <div class="font-semibold text-black dark:text-white pt-3">{f.artikelen}</div>
            <ul class="space-y-1">
              {laatste.map((p) => <li><a class="navlink" href={pad(lang, `/blog/${p.slug}/`)}>{p.data.titel}</a></li>)}
            </ul>
          </>
        )}
      </div>
      <div class="space-y-2">
        <div class="font-semibold text-black dark:text-white">{f.contact}</div>
        <ul class="space-y-1">
          <li><a class="navlink" href={`mailto:${b.mail}`}>{b.mail}</a></li>
          <li><a class="navlink" href={`tel:${tel}`}>{b.telefoon}</a></li>
          <li><a class="navlink" href={b.linkedin}>{f.linkedin}</a></li>
          <li>KvK {b.kvk}</li>
          <li id="privacy">{f.privacy}</li>
        </ul>
      </div>
    </div>
    <div class="flex flex-wrap gap-y-3 justify-between items-center border-t border-black/10 dark:border-white/10 pt-5">
      <div>&copy; {new Date().getFullYear()} {`|`} FortCRM {`|`} <button type="button" data-cookies class="underline underline-offset-2 decoration-black/15 dark:decoration-white/30">{f.cookieknop}</button></div>
      <div class="flex flex-wrap gap-1 items-center">
        <button id="light-theme-button" aria-label="Licht thema" class="group size-8 flex items-center justify-center rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        </button>
        <button id="dark-theme-button" aria-label="Donker thema" class="group size-8 flex items-center justify-center rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        <button id="system-theme-button" aria-label="Thema van je systeem" class="group size-8 flex items-center justify-center rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
        </button>
      </div>
    </div>
    <p class="pt-3 text-xs">{f.partner}</p>
  </Container>
</footer>
