---
import { instellingen, posts } from "@lib/content";
import { pad, SITE, type Lang, pakkettenPad } from "@consts";
import Logo from "@components/Logo.astro";

const { lang } = Astro.props as { lang: Lang };
const i = await instellingen(lang);
const m = i.menu, f = i.footer, b = i.bedrijf;
const laatste = (await posts(lang)).slice(0, SITE.BLOG_IN_FOOTER);
const home = pad(lang);
const tel = (b.telefoon || "").replace(/[^+0-9]/g, "");
const kopje = "eyebrow mb-4";
const link = "text-sm text-inkt/60 hover:text-inkt transition-colors";
---

<footer class="bg-krijt text-inkt border-t border-inkt/10">
  <div class="max-w-6xl mx-auto px-6 py-16 grid gap-12 sm:grid-cols-3">
    <div>
      <p class={kopje}>{f.contact}</p>
      <a href={home} class="inline-block mb-3 text-inkt" aria-label="FortCRM, naar de homepage"><Logo maat={32} /></a>
      <p class="text-sm text-inkt/60 leading-relaxed">{f.tagline}</p>
      <p class="mt-3 text-sm text-inkt/60">KvK {b.kvk}</p>
      <a href={`mailto:${b.mail}`} class={`mt-2 block ${link}`}>{b.mail}</a>
      <a href={`tel:${tel}`} class={`mt-1 block ${link}`}>{b.telefoon}</a>
      <a href={b.linkedin} target="_blank" rel="noopener" class={`mt-4 inline-flex items-center gap-2 ${link}`}>
        <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current flex-shrink-0" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.56V9h3.554v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
        {f.linkedin}
      </a>
    </div>
    <div>
      <p class={kopje}>{f.paginas}</p>
      <ul class="space-y-3">
        {m.pipedrive && <li><a class={link} href={`${home}#pipedrive`}>{m.pipedrive}</a></li>}
        <li><a class={link} href={`${home}#aanpak`}>{m.aanpak}</a></li>
        <li><a class={link} href={`${home}#voor-wie`}>{m.voorWie}</a></li>
        <li><a class={link} href={pakkettenPad(lang)}>{m.pakketten}</a></li>
        {m.quickscan && <li><a class={link} href={pad(lang, SITE.CHECK)}>{m.quickscan}</a></li>}
        <li><a class={link} href={`${home}#over-ons`}>{m.overOns}</a></li>
        <li><a class={link} href={`${home}#faq`}>{m.faq}</a></li>
      </ul>
    </div>
    <div>
      <p class={kopje}>{f.artikelen}</p>
      <ul class="space-y-3">
        {laatste.map((p) => <li><a href={pad(lang, `/blog/${p.slug}/`)} class={`${link} leading-snug`}>{p.data.titel}</a></li>)}
      </ul>
      <a href={pad(lang, "/blog/")} class="inline-block mt-4 text-sm font-medium text-viridiaan hover:underline">{m.blog} →</a>
    </div>
  </div>
  <div class="border-t border-inkt/10">
    <div class="max-w-6xl mx-auto px-6 py-6 flex flex-wrap items-center justify-center md:justify-between gap-x-4 gap-y-2 text-xs text-inkt/60 text-center">
      <span>&copy; {new Date().getFullYear()} FortCRM · <a id="privacy" href={pad(lang, "/privacy/")} class="underline hover:text-inkt transition-colors">{f.privacy}</a>{f.voorwaarden && <> · <a href={lang === "en" ? "/en/terms/" : "/algemene-voorwaarden/"} class="underline hover:text-inkt transition-colors">{f.voorwaarden}</a></>}</span>
      <span>{f.partner}</span>
      <button type="button" data-cookies class="underline hover:text-inkt transition-colors">{f.cookieknop}</button>
    </div>
  </div>
</footer>
