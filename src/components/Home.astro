---
import Sectiekop from "@components/Sectiekop.astro";
import Contact from "@components/Contact.astro";
import Tabel from "@components/Tabel.astro";
import Icoon from "@components/Icoon.astro";
import PipelineBeeld from "@components/PipelineBeeld.astro";
import Bewijs from "@components/Bewijs.astro";
import Pipedrive from "@components/Pipedrive.astro";
import { home } from "@lib/content";
import { splitNadruk } from "@lib/utils";
import { pad, SITE, type Lang } from "@consts";

const { lang } = Astro.props as { lang: Lang };
const h = await home(lang);
const b = h.bewijs ?? {};
const titel = splitNadruk(h.hero.titel);
const [oproepVoor, oproepNa] = h.voorWie.oproepLink && h.voorWie.oproep.includes(h.voorWie.oproepLink)
  ? h.voorWie.oproep.split(h.voorWie.oproepLink)
  : [h.voorWie.oproep, null];
const nl = lang === "nl";
const toonCheck = nl && h.scan?.tonen;
const heeftCijfers = (b.cijfers ?? []).some((c: any) => c.getal);
const nr = (i: number) => String(i + 1).padStart(2, "0");
const swipe = "Swipe ← →";
const meer = h.voorWie.meerTekst || (nl ? "Bekijk wat we inrichten" : "See what we set up");
const belofte = (h.hero.belofte || "").replace(/\*$/, "");
const garantieLink = nl ? "Zo werkt de garantie" : "How the guarantee works";
---

<!-- hero -->
<section class="relative overflow-hidden">
  <div class="wrap pt-14 pb-20 md:pt-20 md:pb-24 grid gap-16 lg:grid-cols-[1fr_1.15fr] lg:items-center">
    <div class="min-w-0">
      <p class="eyebrow mb-6">{h.hero.eyebrow}</p>
      <h1 class="font-display font-bold text-5xl md:text-6xl xl:text-[4.25rem] leading-[1.02] tracking-tight">
        {titel.map((t) => (t.nadruk ? <span class="text-viridiaan">{t.deel}</span> : t.deel))}
      </h1>
      <p class="mt-6 text-lg md:text-xl text-inkt/70 max-w-xl leading-relaxed">{h.hero.intro}</p>
      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="#contact" data-plan class="knop px-8">{h.hero.knopGesprek}</a>
        {h.hero.knopScan && nl ? (
          <a href={SITE.CHECK} class="tekstlink">{h.hero.knopScan} →</a>
        ) : (
          <a href="#pakketten" class="tekstlink">{h.hero.knopPakketten} ↓</a>
        )}
      </div>
      {h.hero.uitleg && <p class="mt-6 text-sm text-inkt/55 max-w-md leading-relaxed">{h.hero.uitleg}</p>}
      {belofte && (
        <p class="mt-10 flex items-start gap-3 text-sm text-inkt/70 max-w-lg">
          <span class="mt-0.5 flex size-5 flex-none items-center justify-center rounded-full bg-viridiaan/15 text-viridiaan"><svg width="11" height="11" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10l4 4 8-8" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
          <span><span class="font-semibold text-inkt">{belofte}</span> <a href="#garantie" class="underline underline-offset-2 decoration-inkt/25 hover:text-inkt">{garantieLink}</a></span>
        </p>
      )}
      {heeftCijfers && <div class="mt-10"><Bewijs deel="cijfers" b={b} /></div>}
    </div>
    <div class="min-w-0 lg:pl-6">
      {h.hero.beeld
        ? <img src={h.hero.beeld} alt={h.hero.beeldAlt || ""} class="w-full rounded-2xl border border-inkt/10 shadow-[0_30px_60px_-30px_rgb(29_33_28/0.45)]" />
        : <PipelineBeeld lang={lang} />}
      {h.hero.beeldOnderschrift && <p class="mt-10 text-sm text-inkt/55 max-w-md">{h.hero.beeldOnderschrift}</p>}
    </div>
  </div>
</section>

<Bewijs deel="logos" b={b} />

<Pipedrive p={h.pipedrive} lang={lang} />

<!-- herkenbaar -->
<section class="py-24 md:py-32">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow mb-4">{h.herkenbaar.eyebrow}</p>
      <h2 class="sectiekop">{h.herkenbaar.titel}</h2>
    </div>
    <div class="mt-16 grid md:grid-cols-3 gap-x-10 gap-y-12">
      {h.herkenbaar.kaarten.map((k: any) => (
        <figure class="reveal border-t border-inkt/20 pt-6">
          <blockquote class="font-display font-semibold text-2xl md:text-[1.7rem] leading-snug tracking-tight">&ldquo;{k.citaat}&rdquo;</blockquote>
          <figcaption class="mt-4 text-inkt/65 leading-relaxed">{k.tekst}</figcaption>
        </figure>
      ))}
    </div>
    <div class="reveal mt-20 max-w-3xl">
      <p class="font-display font-bold text-3xl md:text-4xl leading-tight tracking-tight">{h.herkenbaar.slotVet}</p>
      <p class="mt-4 text-lg text-inkt/70 leading-relaxed">{h.herkenbaar.slot}</p>
    </div>
  </div>
</section>

<!-- aanpak: donkere band met tijdlijn -->
<section id="aanpak" class="band py-24 md:py-32">
  <div class="wrap">
    <div class="reveal grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="eyebrow mb-4">{h.aanpak.eyebrow}</p>
        <h2 class="sectiekop">{h.aanpak.titel}</h2>
      </div>
      {h.aanpak.intro && <p class="intro lg:justify-self-end">{h.aanpak.intro}</p>}
    </div>
    <ol class="mt-20 grid gap-10 lg:grid-cols-5 lg:gap-6 relative">
      <span class="hidden lg:block absolute left-0 right-0 top-5 h-px bg-inkt/15" aria-hidden="true"></span>
      {h.aanpak.stappen.map((s: any, i: number) => (
        <li class="reveal relative">
          <span class:list={["relative flex size-10 items-center justify-center rounded-full font-display font-bold text-sm border", i === 0 ? "bg-vermiljoen border-vermiljoen text-[#1D211C]" : "bg-krijt border-inkt/25"]}>{nr(i)}</span>
          <h3 class="mt-6 font-display font-semibold text-xl">{s.titel}</h3>
          <p class="mt-2 text-inkt/65 leading-relaxed">{s.tekst}</p>
          {s.resultaat && <p class="mt-4 text-sm font-medium text-[#8FBFA6]">{s.resultaat}</p>}
        </li>
      ))}
    </ol>
    {h.aanpak.naderhandTitel && (
      <div class="reveal mt-20 pt-10 border-t border-inkt/15 grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h3 class="font-display font-semibold text-2xl">{h.aanpak.naderhandTitel}</h3>
        <p class="text-lg text-inkt/70 leading-relaxed">{h.aanpak.naderhandTekst}</p>
      </div>
    )}
  </div>
</section>

<!-- voor wie -->
<section id="voor-wie" class="py-24 md:py-32">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow mb-4">{h.voorWie.eyebrow}</p>
      <h2 class="sectiekop">{h.voorWie.titel}</h2>
    </div>
    <div class="mt-16 grid md:grid-cols-3 gap-6">
      {h.voorWie.kaarten.map((k: any, i: number) => {
        const inhoud = (
          <>
            {k.foto && <img src={k.foto} alt="" class="w-full aspect-[16/10] object-cover" loading="lazy" />}
            <div class="p-8 flex flex-col flex-1">
              <div class="flex items-center justify-between text-inkt/40">
                <span class="font-display font-semibold text-sm">{nr(i)}</span>
                {k.icoon && k.icoon !== "geen" && <span class="text-viridiaan"><Icoon naam={k.icoon} maat={22} /></span>}
              </div>
              <h3 class="mt-8 font-display font-semibold text-xl leading-snug transition-colors group-hover:text-viridiaan">{k.titel}</h3>
              <p class="mt-3 text-inkt/65 leading-relaxed">{k.tekst}</p>
              {k.pagina && <span class="mt-auto pt-8 inline-flex items-center gap-2 text-sm font-semibold text-viridiaan">{meer} <span class="transition-transform group-hover:translate-x-1">→</span></span>}
            </div>
          </>
        );
        return k.pagina
          ? <a href={pad(lang, `/${k.pagina}/`)} class="reveal group flex flex-col rounded-2xl border border-inkt/10 bg-white/50 dark:bg-white/[0.03] overflow-hidden kaart-hover">{inhoud}</a>
          : <div class="reveal flex flex-col rounded-2xl border border-inkt/10 overflow-hidden">{inhoud}</div>;
      })}
    </div>
    <div class="reveal mt-16 grid gap-10 md:grid-cols-2 md:gap-16">
      <p class="text-lg text-inkt/75 leading-relaxed">
        {oproepNa !== null ? (<>{oproepVoor}<a href="#contact" data-plan class="font-semibold text-viridiaan underline underline-offset-4 decoration-viridiaan/30 hover:decoration-viridiaan">{h.voorWie.oproepLink}</a>{oproepNa}</>) : oproepVoor}
      </p>
      <div class="border-l border-inkt/15 pl-6">
        <h3 class="font-display font-semibold text-lg">{h.voorWie.nietVoorTitel}</h3>
        <p class="mt-2 text-inkt/65 leading-relaxed">{h.voorWie.nietVoorTekst}</p>
      </div>
    </div>
  </div>
</section>

<Bewijs deel="reviews" b={b} />

<!-- pakketten en SLA -->
<section id="pakketten" class="tint py-24 md:py-32">
  <div class="wrap">
    <div class="reveal grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="eyebrow mb-4">{h.pakketten.eyebrow}</p>
        <h2 class="sectiekop">{h.pakketten.titel}</h2>
      </div>
      {h.pakketten.intro && <p class="intro lg:justify-self-end">{h.pakketten.intro}</p>}
    </div>
    <div class="reveal mt-12"><Tabel kolommen={h.pakketten.kolommen} rijen={h.pakketten.rijen} hint={swipe} /></div>
    <p class="mt-4 text-sm text-inkt/50 max-w-3xl">{h.pakketten.prijsnoot}</p>

    <div class="reveal mt-24 grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="eyebrow mb-4">{h.pakketten.slaEyebrow}</p>
        <h2 class="font-display font-bold text-2xl md:text-3xl leading-tight tracking-tight">{h.pakketten.slaTitel}</h2>
      </div>
      {h.pakketten.slaIntro && <p class="text-inkt/70 leading-relaxed max-w-xl lg:justify-self-end">{h.pakketten.slaIntro}</p>}
    </div>
    <div class="reveal mt-10"><Tabel kolommen={h.pakketten.slaKolommen} rijen={h.pakketten.slaRijen} hint={swipe} /></div>

    <div class="mt-12 flex flex-wrap items-center gap-6">
      <a href="#contact" data-plan class="knop px-8">{h.pakketten.knopVoorstel}</a>
      {h.pakketten.knopScan && nl && <a href={SITE.CHECK} class="tekstlink">{h.pakketten.knopScan} →</a>}
    </div>
  </div>
</section>

<!-- garantie -->
<section id="garantie" class="py-24 md:py-32">
  <div class="wrap grid gap-12 lg:grid-cols-[auto_1fr] lg:gap-24 lg:items-start">
    <div class="reveal leading-none">
      <div class="font-display font-bold text-[7rem] md:text-[10rem] tracking-tighter text-viridiaan tabular-nums">{h.garantie.getal}</div>
      <div class="mt-2 text-sm font-semibold uppercase tracking-wider text-inkt/55">{h.garantie.getalTekst}</div>
    </div>
    <div class="reveal min-w-0 lg:pt-6">
      <p class="eyebrow mb-4">{h.garantie.eyebrow}</p>
      <h2 class="sectiekop">{h.garantie.titel}</h2>
      <ul class="mt-10 grid gap-x-10 gap-y-6 md:grid-cols-2">
        {h.garantie.punten.map((p: string) => <li class="border-t border-inkt/15 pt-4 text-inkt/80 leading-relaxed">{p}</li>)}
      </ul>
      <p class="mt-8 text-sm text-inkt/50">{h.garantie.noot}</p>
    </div>
  </div>
</section>

<Bewijs deel="case" b={b} />

{toonCheck && (
  <section class="pb-24 md:pb-32">
    <div class="wrap">
      <div class="reveal kaart md:p-12 grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
        <div class="max-w-2xl">
          <p class="eyebrow mb-3">{h.scan.eyebrow}</p>
          <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight">{h.scan.titel}</h2>
          <p class="mt-3 text-inkt/70 leading-relaxed">{h.scan.tekst}</p>
        </div>
        <a href={SITE.CHECK} class="knop-lijn px-8">{h.scan.knop} →</a>
      </div>
    </div>
  </section>
)}

<!-- waarom -->
<section id="waarom" class="tint py-24 md:py-32">
  <div class="wrap grid gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
    <div class="reveal lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow mb-4">{h.waarom.eyebrow}</p>
      <h2 class="sectiekop">{h.waarom.titel}</h2>
    </div>
    <ul class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
      {h.waarom.punten.map((p: any) => (
        <li class="reveal">
          <span class="text-viridiaan"><Icoon naam={p.icoon && p.icoon !== "geen" ? p.icoon : "vinkje"} maat={24} /></span>
          <h3 class="mt-4 font-display font-semibold text-lg">{p.titel}</h3>
          <p class="mt-2 text-inkt/65 leading-relaxed">{p.tekst}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<Bewijs deel="video" b={b} />

<!-- team -->
<section id="over-ons" class="py-24 md:py-32">
  <div class="wrap">
    <div class="reveal grid gap-6 lg:grid-cols-2 lg:items-end">
      <div>
        <p class="eyebrow mb-4">{h.team.eyebrow}</p>
        <h2 class="sectiekop">{h.team.titel}</h2>
      </div>
      {h.team.intro && <p class="intro lg:justify-self-end">{h.team.intro}</p>}
    </div>
    <div class="mt-16 grid md:grid-cols-2 gap-10">
      {h.team.mensen.map((m: any) => (
        <article class="reveal grid gap-6 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:items-start">
          {m.foto && <img src={m.foto} alt={m.naam} width="320" height="320" class="w-full aspect-square object-cover rounded-2xl" />}
          <div class="min-w-0">
            <p class="eyebrow mb-2">{m.rol}</p>
            <h3 class="font-display font-semibold text-2xl">{m.naam}</h3>
            <p class="mt-3 text-inkt/70 leading-relaxed">{m.tekst}</p>
            {m.linkedin && (
              <a href={m.linkedin} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2 groenlink">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
                {m.linkedinTekst}
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
    {h.team.noot && <p class="mt-10 text-sm text-inkt/50">{h.team.noot}</p>}
  </div>
</section>

<!-- faq -->
<section id="faq" class="pb-24 md:pb-32">
  <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
    <div class="reveal">
      <p class="eyebrow mb-4">{h.faq.eyebrow}</p>
      <h2 class="sectiekop">{h.faq.titel}</h2>
    </div>
    <div class="reveal divide-y divide-inkt/15 border-y border-inkt/15">
      {h.faq.vragen.map((v: any) => (
        <details class="group py-5">
          <summary class="flex items-center justify-between gap-6 cursor-pointer font-display font-semibold text-lg transition-colors hover:text-viridiaan">
            {v.vraag}
            <span class="flex size-8 flex-none items-center justify-center rounded-full border border-inkt/20 text-xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 pr-12 text-inkt/70 leading-relaxed">{v.antwoord}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<Contact lang={lang} data={h.contact} donker />
