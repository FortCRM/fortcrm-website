---
// Blogoverzicht: dezelfde opbouw als een artikel, met het nieuwste artikel rechts.
import BlogPost from "@components/BlogPost.astro";
import { posts } from "@lib/content";
import type { Lang } from "@consts";

const { lang } = Astro.props as { lang: Lang };
const nieuwste = (await posts(lang))[0];
---

{nieuwste && <BlogPost lang={lang} post={nieuwste} />}
