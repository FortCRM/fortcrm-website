---
import Container from "@components/Container.astro";
import { instellingen, posts } from "@lib/content";
import { formatDatum } from "@lib/utils";
import { pad, type Lang } from "@consts";

const { lang } = Astro.props as { lang: Lang };
const b = (await instellingen(lang)).blog;
const lijst = await posts(lang);
const perJaar = lijst.reduce((acc: Record<string, typeof lijst>, p) => {
  const j = p.data.datum.getFullYear().toString();
  (acc[j] ||= []).push(p);
  return acc;
}, {});
const jaren = Object.keys(perJaar).sort((a, z) => Number(z) - Number(a));
---

<Container>
  <div class="space-y-10">
    <div class="space-y-2">
      <h1 class="animate text-3xl">{b.titel}</h1>
      <p class="animate font-serif">{b.intro}</p>
    </div>
    {jaren.map((jaar) => (
      <section class="animate space-y-4">
        <div class="font-semibold text-black dark:text-white">{jaar}</div>
        <ul class="flex flex-col gap-3">
          {perJaar[jaar].map((p) => (
            <li>
              <a href={pad(lang, `/blog/${p.slug}/`)} class="pijlkaart group">
                <div class="flex flex-col flex-1 min-w-0">
                  <div class="font-semibold text-black dark:text-white">{p.data.titel}</div>
                  <div class="text-sm line-clamp-2">{p.data.omschrijving}</div>
                  <div class="text-xs mt-1">{formatDatum(p.data.datum, lang)}</div>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="absolute top-1/2 right-3 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12" class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out" />
                  <polyline points="12 5 19 12 12 19" class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Container>
