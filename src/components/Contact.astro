---
import { instellingen } from "@lib/content";
import type { Lang } from "@consts";

const { lang, data, tint = true, donker = false } = Astro.props as { lang: Lang; data: any; tint?: boolean; donker?: boolean };
const i = await instellingen(lang);
const f = i.formulier, b = i.bedrijf;
const tel = (b.telefoon || "").replace(/[^+0-9]/g, "");
const opties = ["referral", "linkedin", "zoeken", "netwerk", "pipedrive", "anders"];
---

<section id="contact" class:list={["py-24 md:py-32", donker ? "band" : tint && "tint"]}>
  <div class="wrap grid gap-12 md:grid-cols-2 md:items-start">
    <div>
      <p class="eyebrow mb-4">{data.eyebrow}</p>
      <h2 class="font-display font-bold text-4xl md:text-6xl leading-[1.04] tracking-tight">{data.titel}</h2>
      <p class="mt-5 text-inkt/70 text-lg max-w-xl leading-relaxed">{data.intro}</p>
      <a href="#contact" data-plan class="knop mt-8 px-8">{data.knopPlanner}</a>
      <ul class="mt-10 space-y-2 text-sm text-inkt/70">
        <li><a class="hover:text-inkt transition-colors" href={`mailto:${b.mail}`}>{b.mail}</a></li>
        <li><a class="hover:text-inkt transition-colors" href={`tel:${tel}`}>{b.telefoon}</a></li>
      </ul>
    </div>
    <form class:list={["relative grid gap-4 rounded-2xl border p-6 sm:p-8", donker ? "bg-white/[0.04] border-white/10" : "bg-krijt border-inkt/10"]} id="demo" data-contact novalidate aria-labelledby="contact-formkop">
      {f.kop && (
        <div class="mb-2">
          <h3 id="contact-formkop" class="font-display font-semibold text-2xl">{f.kop}</h3>
          {data.reactietijd && <p class="mt-1 text-sm text-inkt/60">{data.reactietijd}</p>}
        </div>
      )}
      {f.keuzeDemo && (
        <fieldset class="keuze" data-onderwerp>
          <legend class="sr-only">{f.kop}</legend>
          <label><input type="radio" name="onderwerp" value="demo" checked /><span>{f.keuzeDemo}</span></label>
          <label><input type="radio" name="onderwerp" value="vraag" /><span>{f.keuzeVraag}</span></label>
        </fieldset>
      )}
      <label class="veld">{f.naam}<input id="contact-naam" name="naam" autocomplete="name" required /></label>
      <label class="veld">{f.mail}<input id="contact-mail" name="mail" type="email" autocomplete="email" required /></label>
      <label class="veld">{f.bron}
        <select id="contact-bron" name="bron">
          <option value="">{f.bronKies}</option>
          {opties.map((o) => <option value={o}>{f.bronOpties?.[o] ?? o}</option>)}
        </select>
      </label>
      <label class="veld"><span data-vraaglabel data-demo={f.vraagDemo || f.vraag} data-vraag={f.vraag}>{f.keuzeDemo ? (f.vraagDemo || f.vraag) : f.vraag}</span><textarea id="contact-vraag" name="vraag"></textarea></label>
      {f.nieuwsbrief && <label class="chk"><input type="checkbox" name="optin" /><span>{f.nieuwsbrief}</span></label>}
      <div aria-hidden="true" style="position:absolute;left:-9999px"><label>Laat leeg<input name="website" tabindex="-1" autocomplete="off" /></label></div>
      <p class="msg" role="status"></p>
      <button class="knop w-fit" type="submit" data-demo={f.verstuurDemo || f.verstuur} data-vraag={f.verstuur}>{f.keuzeDemo ? (f.verstuurDemo || f.verstuur) : f.verstuur}</button>
      <p class="text-xs text-inkt/50">{f.privacy}</p>
    </form>
  </div>
</section>
