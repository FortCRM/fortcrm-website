---
import Sectiekop from "@components/Sectiekop.astro";
import { instellingen } from "@lib/content";
import type { Lang } from "@consts";

const { lang, data } = Astro.props as { lang: Lang; data: any };
const i = await instellingen(lang);
const f = i.formulier, b = i.bedrijf;
const tel = (b.telefoon || "").replace(/[^+0-9]/g, "");
const opties = ["referral", "linkedin", "zoeken", "netwerk", "pipedrive", "anders"];
---

<section id="contact" class="animate grid gap-8 sm:grid-cols-2 items-start">
  <div class="space-y-5">
    <Sectiekop eyebrow={data.eyebrow} titel={data.titel} intro={data.intro} />
    <a href="#contact" data-plan class="knop">{data.knopPlanner}</a>
    <ul class="space-y-1 text-sm">
      <li><a class="navlink underline underline-offset-2 decoration-black/15 dark:decoration-white/30" href={`mailto:${b.mail}`}>{b.mail}</a></li>
      <li><a class="navlink underline underline-offset-2 decoration-black/15 dark:decoration-white/30" href={`tel:${tel}`}>{b.telefoon}</a></li>
      <li>{data.reactietijd}</li>
    </ul>
  </div>
  <form class="kaart relative grid gap-3 p-5" data-contact novalidate>
    <label class="veld">{f.naam}<input id="contact-naam" name="naam" autocomplete="name" required /></label>
    <label class="veld">{f.mail}<input id="contact-mail" name="mail" type="email" autocomplete="email" required /></label>
    <label class="veld">{f.bron}
      <select id="contact-bron" name="bron">
        <option value="">{f.bronKies}</option>
        {opties.map((o) => <option value={o}>{f.bronOpties?.[o] ?? o}</option>)}
      </select>
    </label>
    <label class="veld">{f.vraag}<textarea id="contact-vraag" name="vraag"></textarea></label>
    <div aria-hidden="true" style="position:absolute;left:-9999px"><label>Laat leeg<input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <p class="msg" role="status"></p>
    <button class="knop w-fit" type="submit">{f.verstuur}</button>
    <p class="text-xs">{f.privacy}</p>
  </form>
</section>
