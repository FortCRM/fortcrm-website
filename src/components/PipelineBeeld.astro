---
// Voorbeeld van een ingerichte pijplijn, als beeld in de hero zolang er geen eigen schermafbeelding is.
// Fictieve namen, geen cijfers of claims.
const { lang = "nl" } = Astro.props as { lang?: "nl" | "en" };
const nl = lang === "nl";
const kolommen = nl
  ? [
      { naam: "Aanvraag", deals: [["Installatiebedrijf Noord", "Offerte opstellen"], ["Studio Oost", "Terugbellen"]] },
      { naam: "Offerte", deals: [["Bouwgroep Zuid", "Opvolgen morgen"], ["Adviesbureau West", "Wacht op akkoord"]] },
      { naam: "Onderhandeling", deals: [["Groothandel Midden", "Contract sturen"]] },
      { naam: "Gewonnen", deals: [["Techniek & Co", "Onboarding gestart"]] },
    ]
  : [
      { naam: "Lead", deals: [["North Installations", "Draft quote"], ["East Studio", "Call back"]] },
      { naam: "Quote", deals: [["South Builders", "Follow up tomorrow"], ["West Advisory", "Awaiting approval"]] },
      { naam: "Negotiation", deals: [["Central Wholesale", "Send contract"]] },
      { naam: "Won", deals: [["Tech & Co", "Onboarding started"]] },
    ];
const stip = ["bg-inkt/30", "bg-oker", "bg-vermiljoen", "bg-viridiaan"];
---

<figure class="relative" aria-label={nl ? "Voorbeeld van een ingerichte pijplijn" : "Example of a configured pipeline"}>
  <div class="absolute -inset-6 rounded-[2.5rem] bg-viridiaan/10 blur-2xl" aria-hidden="true"></div>
  <div class="relative rounded-2xl border border-inkt/10 bg-white dark:bg-[#232a24] shadow-[0_30px_60px_-30px_rgb(29_33_28/0.45)] overflow-hidden">
    <div class="flex items-center gap-2 px-4 py-3 border-b border-inkt/10">
      <span class="size-2.5 rounded-full bg-inkt/15"></span><span class="size-2.5 rounded-full bg-inkt/15"></span><span class="size-2.5 rounded-full bg-inkt/15"></span>
      <span class="ml-3 text-xs font-semibold text-inkt/70">{nl ? "Pijplijn · Verkoop" : "Pipeline · Sales"}</span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 p-4 text-xs leading-tight">
      {kolommen.map((k, i) => (
        <div class:list={["rounded-lg bg-inkt/[0.035] p-2 space-y-2 min-w-0", i > 1 && "hidden sm:block"]}>
          <div class="flex items-center gap-1.5 font-semibold text-inkt/70 truncate"><span class:list={["size-1.5 rounded-full flex-none", stip[i]]}></span>{k.naam}</div>
          {k.deals.map(([bedrijf, taak]) => (
            <div class="rounded-md bg-white dark:bg-[#2c342d] border border-inkt/10 p-2 space-y-1 shadow-sm">
              <div class="font-semibold text-inkt truncate">{bedrijf}</div>
              <div class="text-inkt/55 truncate">{taak}</div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
  <div class="absolute -bottom-5 -left-4 sm:-left-8 rounded-xl border border-inkt/10 bg-white dark:bg-[#2c342d] shadow-lg px-4 py-3 flex items-center gap-3 text-xs">
    <span class="flex size-7 items-center justify-center rounded-full bg-viridiaan/15 text-viridiaan">
      <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10l4 4 8-8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </span>
    <span><span class="block font-semibold text-inkt">{nl ? "Opvolgtaak aangemaakt" : "Follow-up task created"}</span><span class="text-inkt/55">{nl ? "Automatisch, via n8n" : "Automatically, via n8n"}</span></span>
  </div>
  <figcaption class="sr-only">{nl ? "Voorbeeld, fictieve bedrijven" : "Example, fictional companies"}</figcaption>
</figure>
