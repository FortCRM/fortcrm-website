---
import Sectiekop from "@components/Sectiekop.astro";
import Contact from "@components/Contact.astro";
import Icoon from "@components/Icoon.astro";
import { home } from "@lib/content";
import { kleurBij, type KleurNaam } from "@lib/iconen";
import { pad, SITE, type Lang } from "@consts";

const { lang, p } = Astro.props as { lang: Lang; p: any };
const h = await home(lang);
const d = p.data;
const paginaUrl = `${SITE.URL}${Astro.url.pathname}`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Service", name: d.titel, description: d.beschrijving, serviceType: "Pipedrive-implementatie", url: paginaUrl, provider: { "@id": `${SITE.URL}/#organisatie` }, areaServed: "NL" },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: SITE.NAME, item: `${SITE.URL}${pad(lang, "/")}` },
        { "@type": "ListItem", position: 2, name: d.titel, item: paginaUrl },
      ],
    },
  ],
};
const reeks: KleurNaam[] = ["viridiaan", "vermiljoen", "oker"];
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<section class="relative">
  <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">
    <a href={pad(lang, "/#voor-wie")} class="groenlink">← {h.voorWie.eyebrow}</a>
    <p class="mt-8 eyebrow mb-6">{d.eyebrow}</p>
    <h1 class="font-display font-bold text-5xl md:text-6xl xl:text-7xl leading-[1.02] tracking-tight max-w-4xl">{d.kop}</h1>
    <p class="mt-6 text-lg md:text-xl text-inkt/75 max-w-xl leading-relaxed">{d.intro}</p>
    <div class="mt-10 flex flex-wrap items-center gap-6">
      <a href="#contact" data-plan class="knop px-8">{h.hero.knopGesprek}</a>
      {lang === "nl" && h.hero.knopScan && <a href={SITE.CHECK} class="tekstlink">{h.hero.knopScan} →</a>}
    </div>
  </div>
</section>

{d.pijnpunten.length > 0 && (
  <section class="max-w-6xl mx-auto px-6 pb-24 md:pb-32">
    <Sectiekop eyebrow={h.herkenbaar.eyebrow} titel={d.pijnTitel} />
    <div class="mt-12 grid md:grid-cols-3 gap-8">
      {d.pijnpunten.map((t: string, i: number) => (
        <div class="reveal border-t border-inkt/20 pt-6">
          <p class="font-display font-semibold text-2xl leading-snug tracking-tight">{t}</p>
        </div>
      ))}
    </div>
  </section>
)}

{d.inrichting.length > 0 && (
  <section class="band py-24 md:py-32">
    <div class="wrap">
      <Sectiekop eyebrow={d.eyebrow} titel={d.inrichtingTitel} />
      <div class:list={["mt-12 grid gap-8", d.inrichting.length === 4 ? "sm:grid-cols-2 lg:grid-cols-4" : "md:grid-cols-3"]}>
        {d.inrichting.map((k: any, i: number) => {
          return (
            <div class="reveal rounded-2xl border border-inkt/10 bg-white/[0.04] p-8">
              {k.icoon && k.icoon !== "geen" && <span class="block mb-6 text-[#8FBFA6]"><Icoon naam={k.icoon} maat={24} /></span>}
              <h3 class="font-display font-semibold text-lg mb-2">{k.titel}</h3>
              <p class="text-inkt/70 leading-relaxed">{k.tekst}</p>
            </div>
          );
        })}
      </div>
      {d.slot && <p class="mt-16 font-display font-bold text-3xl md:text-4xl leading-tight tracking-tight max-w-3xl">{d.slot}</p>}
    </div>
  </section>
)}

<Contact lang={lang} data={h.contact} tint={false} />
