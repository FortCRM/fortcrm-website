---
// Blog in twee kolommen: links alle artikelen, rechts de tekst. Elk artikel houdt zijn eigen URL.
import { instellingen, posts } from "@lib/content";
import { formatDatum } from "@lib/utils";
import { pad, type Lang } from "@consts";

const { lang, actief } = Astro.props as { lang: Lang; actief?: string };
const b = (await instellingen(lang)).blog;
const lijst = await posts(lang);
const huidig = actief ?? lijst[0]?.slug;
const kop = lang === "nl" ? "Alle artikelen" : "All articles";
---

<section class="wrap py-12 md:py-16">
  <div class="grid gap-10 lg:grid-cols-[300px_minmax(0,1fr)] xl:grid-cols-[340px_minmax(0,1fr)] lg:gap-16">
    <aside class="min-w-0 lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow mb-2">FortCRM {b.titel}</p>
      <p class="text-sm text-inkt/60 leading-relaxed mb-6 hidden lg:block">{b.intro}</p>
      <details class="blogmenu group rounded-2xl border border-inkt/15 lg:border-0 lg:rounded-none" open>
        <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-display font-semibold lg:hidden">
          {kop} ({lijst.length})
          <span class="text-xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <nav aria-label={kop} class="max-h-[60vh] lg:max-h-[calc(100vh-10rem)] overflow-y-auto overscroll-contain px-2 pb-2 lg:px-0 lg:pr-3">
          <ul class="space-y-1">
            {lijst.map((p) => (
              <li>
                <a
                  href={pad(lang, `/blog/${p.slug}/`)}
                  data-blogitem={p.slug}
                  aria-current={p.slug === huidig ? "page" : undefined}
                  class="blogitem block rounded-xl px-3 py-3 border-l-2 border-transparent transition-colors hover:bg-inkt/[0.05]"
                >
                  <span class="block text-xs text-inkt/50">{formatDatum(p.data.datum, lang)}</span>
                  <span class="mt-1 block font-display font-semibold leading-snug">{p.data.seoTitel || p.data.titel}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </aside>
    <div class="min-w-0" data-blogtekst>
      <slot />
    </div>
  </div>
</section>
