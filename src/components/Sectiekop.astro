---
const { eyebrow, titel, intro, class: klasse = "" } = Astro.props as { eyebrow?: string; titel?: string; intro?: string; class?: string };
---

<div class={klasse}>
  {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
  {titel && <h2 class="sectiekop">{titel}</h2>}
  {intro && <p class="intro mt-5">{intro}</p>}
  <slot />
</div>
