---
// Pipedrive-partnerschap: badge, voordelen en de functies van Pipedrive. Inhoud uit Keystatic (homepage > Pipedrive-partnerschap).
import Icoon from "@components/Icoon.astro";
const { p, lang } = Astro.props as { p: any; lang: "nl" | "en" };
const functies = (p?.functies ?? []).filter((f: any) => f.titel);
---

{p?.titel && (
  <section id="pipedrive" class="tint py-24 md:py-32">
    <div class="wrap">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
        <div class="reveal min-w-0">
          <p class="eyebrow mb-4">{p.eyebrow}</p>
          <h2 class="sectiekop">{p.titel}</h2>
          {p.tekst && <p class="intro mt-5">{p.tekst}</p>}
          {p.voordelen?.length > 0 && (
            <ul class="mt-8 space-y-3">
              {p.voordelen.map((v: string) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex size-5 flex-none items-center justify-center rounded-full bg-viridiaan text-krijt dark:bg-[#8FBFA6] dark:text-[#1D211C]"><svg width="11" height="11" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10l4 4 8-8" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
                  <span class="text-inkt/80">{v}</span>
                </li>
              ))}
            </ul>
          )}
          {p.knop && p.knopLink && <a href={p.knopLink} target="_blank" rel="noopener" class="mt-8 inline-block groenlink">{p.knop} →</a>}
        </div>
        <div class="reveal flex lg:justify-end">
          <img src="/images/pipedrive/authorized-partner.png" width="480" height="301" alt="Pipedrive Authorized Partner" class="w-full max-w-[200px] lg:max-w-[240px] drop-shadow-[0_16px_28px_rgb(29_33_28/0.2)]" />
        </div>
      </div>

      {functies.length > 0 && (
        <div class="mt-20">
          {p.functiesTitel && <h3 class="reveal font-display font-bold text-2xl md:text-3xl tracking-tight">{p.functiesTitel}</h3>}
          <ul class:list={["mt-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8", functies.length % 4 === 0 ? "lg:grid-cols-4" : functies.length % 5 === 0 ? "lg:grid-cols-5" : "lg:grid-cols-3"]}>
            {functies.map((f: any) => (
              <li class="reveal border-t border-inkt/15 pt-5">
                {f.icoon && f.icoon !== "geen" && <span class="text-viridiaan"><Icoon naam={f.icoon} maat={26} /></span>}
                <h4 class="mt-4 font-display font-semibold text-lg">{f.titel}</h4>
                <p class="mt-2 text-sm text-inkt/65 leading-relaxed">{f.tekst}</p>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
)}
