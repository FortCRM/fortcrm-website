---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Overlays from "@components/Overlays.astro";
import type { Lang } from "@consts";

type Props = {
  title: string;
  description: string;
  socialTitle?: string;
  lang?: Lang;
  vertaling?: string;
};

const { title, description, socialTitle, lang = "nl", vertaling } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head title={title} description={description} socialTitle={socialTitle} lang={lang} vertaling={vertaling} />
  </head>
  <body>
    <Header lang={lang} vertaling={vertaling} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <Overlays lang={lang} />
  </body>
</html>
