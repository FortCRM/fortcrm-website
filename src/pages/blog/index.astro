---
import PageLayout from "@layouts/PageLayout.astro";
import BlogIndex from "@components/BlogIndex.astro";
import { instellingen, posts } from "@lib/content";
import { pad } from "@consts";
const b = (await instellingen("nl")).blog;
const nieuwste = (await posts("nl"))[0];
---

<PageLayout canonical={nieuwste ? pad("nl", `/blog/${nieuwste.slug}/`) : undefined} title={`${b.titel} | FortCRM`} description={b.beschrijving} lang="nl" vertaling="/en/blog/">
  <BlogIndex lang="nl" />
</PageLayout>
