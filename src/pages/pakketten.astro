<PageLayout title={h.pakketten.paginaTitel || "Pakketten en prijzen | FortCRM"} description={h.pakketten.paginaBeschrijving || h.seo.beschrijving} lang="nl" vertaling="/en/packages/">
  <PakkettenPagina lang="nl" />
</PageLayout>
