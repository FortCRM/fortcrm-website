---
import PageLayout from "@layouts/PageLayout.astro";
import { getEntry } from "astro:content";
const scan = (await getEntry("quickscan", "nl"))?.data ?? null;
---

<PageLayout title="CRM-check: hoe staat je CRM-basis ervoor? | FortCRM" description="Zes vragen, twee minuten. Zie direct hoe het staat met vastleggen, opvolgen en delen in je bedrijf." lang="nl" vertaling="/en/crm-check/">
  <script is:inline define:vars={{ scan }}>window.FORTCRM_SCAN = scan;</script>
  <section>
    <div class="max-w-3xl mx-auto px-6 py-20 md:py-24">
      <p class="eyebrow mb-6">CRM-check</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl leading-[1.05]">Hoe staat je CRM-basis ervoor?</h1>
      <p class="mt-6 text-lg text-inkt/75 leading-relaxed max-w-xl">Zes vragen, twee minuten. Je ziet direct hoe het staat met vastleggen, opvolgen en delen, en waar je als eerste winst haalt.</p>
      <div class="mt-10 grid gap-6" id="scan">
        <div><ol class="prog" data-prog aria-label="Voortgang"></ol></div>
        <div data-body></div>
      </div>
    </div>
  </section>
</PageLayout>
