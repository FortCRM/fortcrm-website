---
import PageLayout from "@layouts/PageLayout.astro";
import Pagina from "@components/Pagina.astro";
import { getEntry } from "astro:content";
const pagina = await getEntry("pagina", "privacy-en");
---

<PageLayout title={`${pagina!.data.titel} | FortCRM`} description={pagina!.data.omschrijving} lang="en" vertaling="/privacy/">
  <Pagina lang="en" pagina={pagina} />
</PageLayout>
